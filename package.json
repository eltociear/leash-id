{
  "name": "leash-id",
  "version": "0.2.0",
  "description": "KYC-backed spending leashes for AI agents on ME Network: a CosmWasm contract on ME Hub, an MCP server and a CLI",
  "scripts": {
    "test": "npm run test:contract && npm run test:js",
    "test:contract": "cd contracts/leash-id && cargo +1.81.0 test -q",
    "test:js": "node --test test/",
    "build": "bash scripts/build.sh",
    "verify": "node scripts/verify.mjs",
    "devnet": "bash scripts/devnet-runs.sh"
  },
  "keywords": [
    "me-network",
    "me-hub",
    "cosmwasm",
    "mcp",
    "ai-agents",
    "kyc",
    "spending-limits"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@cosmjs/cosmwasm-stargate": "^0.32.4",
    "@cosmjs/crypto": "^0.32.4",
    "@cosmjs/encoding": "^0.32.4",
    "@cosmjs/proto-signing": "^0.32.4",
    "@cosmjs/stargate": "^0.32.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "binaryen": "^116.0.0"
  },
  "bin": {
    "leash": "leash.mjs",
    "leash-mcp": "mcp/server.mjs"
  },
  "exports": {
    ".": "./lib/chain.mjs",
    "./chain": "./lib/chain.mjs",
    "./tx": "./lib/tx.mjs"
  },
  "files": [
    "leash.mjs",
    "lib/",
    "mcp/server.mjs",
    "mcp/*.mcp.json",
    "inbox/demo.json",
    "artifacts/leash_id.wasm",
    "artifacts/checksums.txt",
    "deployment.json",
    "docs/",
    "README.md",
    "SECURITY.md",
    "THREAT_MODEL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eltociear/leash-id.git"
  }
}
