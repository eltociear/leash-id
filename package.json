{
  "name": "leash-id",
  "version": "0.6.0",
  "description": "KYC-backed spending leashes for AI agents on ME Network: a CosmWasm contract on ME Hub, an MCP server and a CLI",
  "scripts": {
    "test": "npm run test:contract && npm run test:js",
    "test:contract": "cd contracts/leash-id && cargo +1.81.0 test -q",
    "test:js": "node --test test/*.test.mjs",
    "build": "bash scripts/build.sh",
    "verify": "node scripts/verify.mjs",
    "check:chain": "node scripts/check-chain.mjs",
    "devnet": "bash scripts/devnet-runs.sh",
    "bundle:web": "bash scripts/bundle-web.sh",
    "e2e:owner": "node scripts/e2e-owner.mjs",
    "docs": "node scripts/serve-docs.mjs"
  },
  "keywords": [
    "me-network",
    "me-hub",
    "cosmwasm",
    "mcp",
    "ai-agents",
    "kyc",
    "spending-limits"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@cosmjs/amino": "^0.38.1",
    "@cosmjs/cosmwasm-stargate": "^0.38.1",
    "@cosmjs/crypto": "^0.38.1",
    "@cosmjs/encoding": "^0.38.1",
    "@cosmjs/proto-signing": "^0.38.1",
    "@cosmjs/stargate": "^0.38.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cosmjs-types": "^0.11.0",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "binaryen": "^116.0.0",
    "esbuild": "^0.25.12",
    "puppeteer-core": "^24.43.1"
  },
  "bin": {
    "leash": "leash.mjs",
    "leash-mcp": "mcp/server.mjs"
  },
  "exports": {
    ".": "./lib/chain.mjs",
    "./chain": "./lib/chain.mjs",
    "./tx": "./lib/tx.mjs",
    "./vendor": "./lib/vendor.mjs"
  },
  "files": [
    "leash.mjs",
    "lib/",
    "mcp/server.mjs",
    "mcp/*.mcp.json",
    "inbox/demo.json",
    "artifacts/leash_id.wasm",
    "artifacts/checksums.txt",
    "deployment.json",
    "docs/",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.zh-CN.md",
    "README.ja.md",
    "THREAT_MODEL.md",
    "LICENSE",
    "examples/"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eltociear/leash-id.git"
  }
}
